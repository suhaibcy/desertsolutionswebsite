{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/marketing/**",
              "components/navigation/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Anton|DM Sans))/i]",
        "message": "Font not provided by the design system. Available: Anton, DM Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|pill|dot|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: variant, pill, dot, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|outline|solid)$/]",
        "message": "<Badge> variant must be one of 'accent' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|disabled|fullWidth|arrow|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, disabled, fullWidth, arrow, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|onSunset)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'onSunset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:elevated|interactive|padding|radius|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: elevated, interactive, padding, radius, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConsultationBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|body|style|key|ref|className|style|children)$/]",
        "message": "<ConsultationBand> doesn't accept that prop. Declared props: headline, body, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:headline|sub|phone|style|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: headline, sub, phone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|required|as|options|rows|placeholder|type|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, hint, required, as, options, rows, placeholder, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:input|select|textarea)$/]",
        "message": "<Field> as must be one of 'input' | 'select' | 'textarea'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:phone|email|area|links|services|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: phone, email, area, links, services, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|sub|phone|style|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: eyebrow, headline, sub, phone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|label|size|variant|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: name, label, size, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|solid|tile)$/]",
        "message": "<IconButton> variant must be one of 'outline' | 'solid' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|label|caption|src|tilt|height|style|key|ref|className|style|children)$/]",
        "message": "<ImageFrame> doesn't accept that prop. Declared props: shape, label, caption, src, tilt, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageFrame'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:arch|rounded|oval)$/]",
        "message": "<ImageFrame> shape must be one of 'arch' | 'rounded' | 'oval'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|href|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:mark|wordmark)$/]",
        "message": "<Logo> variant must be one of 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProcessStep'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|key|ref|className|style|children)$/]",
        "message": "<ProcessStep> doesn't accept that prop. Declared props: icon, title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteForm'] > JSXAttribute > JSXIdentifier[name!=/^(?:services|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<QuoteForm> doesn't accept that prop. Declared props: services, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|intro|align|size|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, intro, align, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<SectionHeading> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|name|description|style|key|ref|className|style|children)$/]",
        "message": "<ServiceCard> doesn't accept that prop. Declared props: icon, name, description, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceIcon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|tone|alt|key|ref|className|style|children)$/]",
        "message": "<ServiceIcon> doesn't accept that prop. Declared props: name, size, tone, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='ServiceIcon'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dark|chrome|muted)$/]",
        "message": "<ServiceIcon> tone must be one of 'accent' | 'dark' | 'chrome' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBandItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|suffix|label|key|ref|className|style|children)$/]",
        "message": "<StatBandItem> doesn't accept that prop. Declared props: value, suffix, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatRowItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|key|ref|className|style|children)$/]",
        "message": "<StatRowItem> doesn't accept that prop. Declared props: icon, value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TickerBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|speed|style|key|ref|className|style|children)$/]",
        "message": "<TickerBand> doesn't accept that prop. Declared props: items, speed, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|phone|active|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: links, phone, active, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='UtilityBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:area|email|note|style|key|ref|className|style|children)$/]",
        "message": "<UtilityBar> doesn't accept that prop. Declared props: area, email, note, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
